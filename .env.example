DATABASE_URL="postgresql://user:password@host:5432/vespadatabase"
SESSION_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"

# Optional — set to send real magic-link emails via Resend.
# RESEND_API_KEY=
# EMAIL_FROM="VespaDatabase <onboarding@resend.dev>"

# Optional — set to store uploaded photos in Supabase Storage (bucket
# "photos", must be public). Falls back to local disk if unset.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
