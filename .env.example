DATABASE_URL="postgresql://user:password@host:5432/vespadatabase"
# Used by `prisma migrate` specifically. On Supabase, DATABASE_URL should be
# the pooled connection and DIRECT_URL the direct/session-pooler connection
# (required for migrations — the pooled one is often IPv6-only or doesn't
# support the operations migrations need). For plain Postgres, same value
# as DATABASE_URL is fine.
DIRECT_URL="postgresql://user:password@host:5432/vespadatabase"
SESSION_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"

# Optional — set to send real magic-link emails via Resend.
# RESEND_API_KEY=
# EMAIL_FROM="VespaDatabase <onboarding@resend.dev>"

# Optional — set to store uploaded photos in Supabase Storage (bucket
# "photos", must be public). Falls back to local disk if unset.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
