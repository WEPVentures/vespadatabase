// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?  @unique
  createdAt DateTime @default(now())

  vespas      Vespa[]
  loginTokens LoginToken[]
}

model LoginToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([email])
}

model Vespa {
  id        String   @id @default(cuid())
  year      Int?
  model     String
  vin       String?
  color     String?
  story     String?
  createdAt DateTime @default(now())

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  photos Photo[]

  @@index([ownerId])
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  createdAt DateTime @default(now())

  vespa   Vespa  @relation(fields: [vespaId], references: [id], onDelete: Cascade)
  vespaId String

  @@index([vespaId])
}
